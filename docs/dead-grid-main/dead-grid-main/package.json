{
  "name": "dead-grid",
  "version": "1.7.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test src/*.test.ts",
    "balance": "node --import tsx scripts/balance.ts",
    "format": "prettier --write src scripts *.json *.ts index.html README.md DESIGN.md",
    "probe": "node --import tsx scripts/combat-probe.ts",
    "performance": "node --import tsx scripts/performance.ts final"
  },
  "dependencies": {
    "@react-three/fiber": "^9.3.0",
    "koota": "0.6.6",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
